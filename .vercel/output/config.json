{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro(?:/(.*))$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/cache/revalidate\\.json$",
			"dest": "_render"
		},
		{
			"src": "^/api/menu/catalog\\.json$",
			"dest": "_render"
		},
		{
			"src": "^/api/settings/public\\.json$",
			"dest": "_render"
		},
		{
			"src": "^/api/songs/filters\\.json$",
			"dest": "_render"
		},
		{
			"src": "^/api/songs/popular-artists\\.json$",
			"dest": "_render"
		},
		{
			"src": "^/api/songs/search\\.json$",
			"dest": "_render"
		},
		{
			"src": "^/canciones/?$",
			"dest": "_render"
		},
		{
			"src": "^/carta/?$",
			"dest": "_render"
		},
		{
			"src": "^/menu/?$",
			"dest": "_render"
		},
		{
			"src": "^/reglas/?$",
			"dest": "_render"
		},
		{
			"src": "^/resumen-carta/?$",
			"dest": "_render"
		},
		{
			"src": "^/resumen-musica/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render"
		}
	]
}