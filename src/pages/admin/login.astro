---
import { createSupabaseSsrClient } from "../../lib/supabase-ssr.js";
import Layout from "../../layouts/Layout.astro";

// Esta página también revisa la sesión en el servidor antes de mostrar el formulario.
const supabase = createSupabaseSsrClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

Astro.response.headers.set("Cache-Control", "private, no-store, max-age=0");

let loginMessage = "";
const errorCode = Astro.url.searchParams.get("error");

if (errorCode === "no-autorizado") {
  loginMessage = "Esta cuenta no tiene permisos para administrar el local.";
} else if (errorCode === "verificacion") {
  loginMessage = "No pudimos comprobar el acceso. Intenta nuevamente.";
}

const { data: loginResult } = await supabase.auth.getClaims();
const userId = loginResult?.claims?.sub;

if (userId) {
  const { data: adminRecord, error } = await supabase
    .from("admin_users")
    .select("user_id")
    .eq("user_id", userId)
    .maybeSingle();

  if (!error && adminRecord) {
    return Astro.redirect("/admin");
  }

  if (!error) {
    await supabase.auth.signOut();
    loginMessage = "Esta cuenta no tiene permisos para administrar el local.";
  } else {
    loginMessage = "No pudimos comprobar el acceso. Intenta nuevamente.";
  }
}
---

<Layout title="Iniciar sesión - Panel de administración">
  <main class="auth-page">
  <div
    class="auth-page__glow auth-page__glow--primary"
    aria-hidden="true"
  ></div>
  <div class="auth-page__glow auth-page__glow--accent" aria-hidden="true"></div>

  <section class="auth-card" aria-labelledby="login-title">
    <header class="auth-card__header">
      <div class="auth-card__logo" aria-hidden="true">
        <iconify-icon
          icon="lucide:mic-vocal"
          class="auth-card__logo-icon"
        ></iconify-icon>
      </div>
      <span class="auth-card__badge">PANEL DE GESTIÓN</span>
      <h1 class="auth-card__title" id="login-title">
        Bienvenido de vuelta
      </h1>
      <p class="auth-card__subtitle">
        Ingresa tus credenciales para administrar el repertorio y los pedidos.
      </p>
    </header>

    <div
      class:list={["auth-alert", !loginMessage && "auth-alert--hidden"]}
      id="login-alert"
      role="alert"
      aria-live="polite"
    >
      <iconify-icon
        icon="lucide:alert-circle"
        class="auth-alert__icon"
        aria-hidden="true"
      ></iconify-icon>
      <span id="login-alert-text">{loginMessage}</span>
    </div>

    <form class="auth-form" id="admin-login-form" novalidate>
      <div class="form-group">
        <label class="form-group__label" for="admin-email">
          Correo electrónico
        </label>
        <div class="input-box">
          <iconify-icon
            icon="lucide:mail"
            class="input-box__icon"
            aria-hidden="true"
          ></iconify-icon>
          <input
            type="email"
            id="admin-email"
            name="email"
            class="input-box__field"
            placeholder="admin@karaokebar.com"
            autocomplete="email"
            required
          />
        </div>
      </div>

      <div class="form-group">
        <label class="form-group__label" for="admin-password">
          Contraseña
        </label>
        <div class="input-box">
          <iconify-icon
            icon="lucide:lock"
            class="input-box__icon"
            aria-hidden="true"
          ></iconify-icon>
          <input
            type="password"
            id="admin-password"
            name="password"
            class="input-box__field input-box__field--password"
            placeholder="Escribe tu contraseña"
            autocomplete="current-password"
            required
          />
          <button
            type="button"
            class="input-box__toggle"
            id="toggle-password"
            aria-label="Mostrar contraseña"
            aria-pressed="false"
          >
            <iconify-icon
              icon="lucide:eye"
              id="toggle-password-icon"
              aria-hidden="true"
            ></iconify-icon>
          </button>
        </div>
      </div>

      <div class="auth-form__options">
        <label class="checkbox">
          <input
            type="checkbox"
            class="checkbox__input"
            id="remember-me"
            checked
          />
          <span class="checkbox__box" aria-hidden="true">
            <iconify-icon
              icon="lucide:check"
              class="checkbox__check"
            ></iconify-icon>
          </span>
          <span class="checkbox__text">Mantener sesión iniciada</span>
        </label>
      </div>

      <button type="submit" class="btn-submit" id="login-submit">
        <span class="btn-submit__text">Ingresar al panel</span>
        <iconify-icon
          icon="lucide:arrow-right"
          class="btn-submit__icon"
          aria-hidden="true"
        ></iconify-icon>
      </button>
    </form>

    <footer class="auth-card__footer">
      <a href="/" class="auth-card__back-link">
        <iconify-icon
          icon="lucide:arrow-left"
          aria-hidden="true"
        ></iconify-icon>
        <span>Volver al menú de clientes</span>
      </a>
    </footer>
  </section>
  </main>
</Layout>

<style>
  /* =========================================
     VARIABLES & RESET
     ========================================= */
  .auth-page {
    --bg-canvas: #050814;
    --bg-card: rgba(15, 23, 42, 0.78);
    --bg-input: #090e1f;

    --border-subtle: rgba(148, 163, 184, 0.14);
    --border-focus: #8b5cf6;

    --primary: #7c3aed;
    --primary-hover: #8b5cf6;
    --accent-pink: #ec4899;

    --text-main: #f8fafc;
    --text-muted: #94a3b8;
    --text-dim: #64748b;

    --danger-bg: rgba(244, 63, 94, 0.12);
    --danger-border: rgba(244, 63, 94, 0.35);
    --danger-text: #fda4af;

    --radius-md: 0.75rem;
    --radius-xl: 1.25rem;
    --font-sans:
      system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
      sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* =========================================
     BLOQUE: AUTH PAGE (.auth-page)
     ========================================= */
  .auth-page {
    position: fixed;
    inset: 0;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    background-color: var(--bg-canvas);
    background-image: radial-gradient(
      rgba(148, 163, 184, 0.08) 1px,
      transparent 1px
    );
    background-size: 24px 24px;
    font-family: var(--font-sans);
    color: var(--text-main);
    overflow-x: hidden;
    overflow-y: auto;
    z-index: 100;
    -webkit-font-smoothing: antialiased;
  }

  .auth-page__glow {
    position: fixed;
    width: 22rem;
    height: 22rem;
    border-radius: 9999px;
    filter: blur(110px);
    opacity: 0.28;
    pointer-events: none;
    z-index: 0;
  }

  .auth-page__glow--primary {
    top: -6rem;
    left: -4rem;
    background: var(--primary);
  }

  .auth-page__glow--accent {
    bottom: -6rem;
    right: -4rem;
    background: var(--accent-pink);
  }

  /* =========================================
     BLOQUE: AUTH CARD (.auth-card)
     ========================================= */
  .auth-card {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 26rem;
    background: var(--bg-card);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: 2.25rem 2rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.75);
  }

  .auth-card__header {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .auth-card__logo {
    width: 3.5rem;
    height: 3.5rem;
    margin: 0 auto 1rem;
    border-radius: 1rem;
    background: linear-gradient(
      135deg,
      rgba(124, 58, 237, 0.25),
      rgba(236, 72, 153, 0.2)
    );
    border: 1px solid rgba(139, 92, 246, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 25px -5px rgba(124, 58, 237, 0.35);
  }

  .auth-card__logo-icon {
    font-size: 1.75rem;
    color: #c4b5fd;
  }

  .auth-card__badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #a78bfa;
    background: rgba(139, 92, 246, 0.12);
    border: 1px solid rgba(139, 92, 246, 0.25);
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    margin-bottom: 0.625rem;
  }

  .auth-card__title {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-main);
  }

  .auth-card__subtitle {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-top: 0.375rem;
    line-height: 1.45;
  }

  .auth-card__footer {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
    text-align: center;
  }

  .auth-card__back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .auth-card__back-link:hover {
    color: var(--text-main);
  }

  /* =========================================
     BLOQUE: ALERTA (.auth-alert)
     ========================================= */
  .auth-alert {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 0.875rem;
    margin-bottom: 1.25rem;
    border-radius: var(--radius-md);
    background-color: var(--danger-bg);
    border: 1px solid var(--danger-border);
    color: var(--danger-text);
    font-size: 0.8125rem;
  }

  .auth-alert--hidden {
    display: none;
  }

  .auth-alert__icon {
    font-size: 1.125rem;
    flex-shrink: 0;
  }

  /* =========================================
     BLOQUE: FORMULARIO (.auth-form & .form-group)
     ========================================= */
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4375rem;
  }

  .form-group__label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .form-group__label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #cbd5e1;
  }

  /* =========================================
     BLOQUE: INPUT BOX (.input-box)
     ========================================= */
  .input-box {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-box__icon {
    position: absolute;
    left: 0.9375rem;
    font-size: 1.125rem;
    color: var(--text-dim);
    pointer-events: none;
    transition: color 0.15s ease;
  }

  .input-box__field {
    width: 100%;
    height: 2.875rem;
    background-color: var(--bg-input);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0 1rem 0 2.75rem;
    font-size: 0.9375rem;
    color: var(--text-main);
    outline: none;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .input-box__field--password {
    padding-right: 2.75rem;
  }

  .input-box__field::placeholder {
    color: var(--text-dim);
  }

  .input-box__field:focus {
    border-color: var(--border-focus);
    box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.22);
  }

  .input-box:focus-within .input-box__icon {
    color: #a78bfa;
  }

  .input-box__toggle {
    position: absolute;
    right: 0.75rem;
    background: transparent;
    border: none;
    color: var(--text-muted);
    padding: 0.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.125rem;
    cursor: pointer;
    border-radius: 0.375rem;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .input-box__toggle:hover {
    color: var(--text-main);
    background-color: rgba(255, 255, 255, 0.06);
  }

  /* =========================================
     BLOQUE: CHECKBOX PERSONALIZADO (.checkbox)
     ========================================= */
  .auth-form__options {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: -0.125rem;
  }

  .checkbox {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    user-select: none;
  }

  .checkbox__input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .checkbox__box {
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 0.3125rem;
    background-color: var(--bg-input);
    border: 1px solid #334155;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .checkbox__check {
    font-size: 0.75rem;
    color: #ffffff;
    opacity: 0;
    transform: scale(0.7);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  .checkbox__input:checked + .checkbox__box {
    background-color: var(--primary);
    border-color: var(--primary-hover);
  }

  .checkbox__input:checked + .checkbox__box .checkbox__check {
    opacity: 1;
    transform: scale(1);
  }

  .checkbox__text {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  /* =========================================
     BLOQUE: BOTÓN PRINCIPAL (.btn-submit)
     ========================================= */
  .btn-submit {
    width: 100%;
    height: 2.875rem;
    margin-top: 0.375rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border: none;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, var(--primary), #6d28d9);
    color: #ffffff;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 10px 25px -5px rgba(124, 58, 237, 0.5);
    transition:
      transform 0.15s ease,
      filter 0.15s ease,
      box-shadow 0.15s ease;
  }

  .btn-submit:hover:not(:disabled) {
    filter: brightness(1.1);
    box-shadow: 0 14px 28px -5px rgba(124, 58, 237, 0.65);
  }

  .btn-submit:active:not(:disabled) {
    transform: scale(0.985);
  }

  .btn-submit--loading {
    opacity: 0.75;
    cursor: wait;
  }

  .btn-submit__icon {
    font-size: 1.125rem;
    transition: transform 0.15s ease;
  }

  .btn-submit:hover .btn-submit__icon {
    transform: translateX(3px);
  }

  /* =========================================
     RESPONSIVE MÓVIL
     ========================================= */
  @media (max-width: 420px) {
    .auth-card {
      padding: 1.75rem 1.375rem;
    }
  }
</style>

<script>
  import { supabase } from "../../scripts/supabase.js";

  const form = document.querySelector("#admin-login-form");
  const emailInput = document.querySelector("#admin-email");
  const passwordInput = document.querySelector("#admin-password");
  const togglePasswordButton = document.querySelector("#toggle-password");
  const togglePasswordIcon = document.querySelector("#toggle-password-icon");
  const alertBox = document.querySelector("#login-alert");
  const alertText = document.querySelector("#login-alert-text");
  const submitButton = document.querySelector("#login-submit");
  const submitText = submitButton.querySelector(".btn-submit__text");

  function showLoginError(message) {
    alertText.textContent = message;
    alertBox.classList.remove("auth-alert--hidden");
  }

  togglePasswordButton.addEventListener("click", () => {
    const shouldShowPassword = passwordInput.type === "password";
    passwordInput.type = shouldShowPassword ? "text" : "password";
    togglePasswordIcon.setAttribute(
      "icon",
      shouldShowPassword ? "lucide:eye-off" : "lucide:eye",
    );
    togglePasswordButton.setAttribute(
      "aria-pressed",
      String(shouldShowPassword),
    );
    togglePasswordButton.setAttribute(
      "aria-label",
      shouldShowPassword ? "Ocultar contraseña" : "Mostrar contraseña",
    );
  });

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    alertBox.classList.add("auth-alert--hidden");

    const email = emailInput.value.trim();
    const password = passwordInput.value;

    if (!email || !password) {
      showLoginError("Escribe tu correo y contraseña para continuar.");
      return;
    }

    submitButton.disabled = true;
    submitButton.classList.add("btn-submit--loading");
    submitText.textContent = "Verificando...";

    try {
      const { error } = await supabase.auth.signInWithPassword({
        email,
        password,
      });

      if (error) {
        showLoginError("El correo o la contraseña son incorrectos.");
        return;
      }

      window.location.assign("/admin");
    } catch (error) {
      console.error("No se pudo iniciar sesión:", error);
      showLoginError(
        "No se pudo conectar. Revisa tu conexión e inténtalo otra vez.",
      );
    } finally {
      submitButton.disabled = false;
      submitButton.classList.remove("btn-submit--loading");
      submitText.textContent = "Ingresar al panel";
    }
  });
</script>
