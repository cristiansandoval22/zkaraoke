---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminSidebar from "../../components/AdminSidebar.astro";
import StatCard from "../../components/StatCard.astro";
import ArtistManager from "../../components/admin/ArtistManager.astro";
import AdminRecordModal from "../../components/admin/AdminRecordModal.astro";
import AdminSongsSection from "../../components/admin/AdminSongsSection.astro";
import AdminProductsSection from "../../components/admin/AdminProductsSection.astro";
import AdminCategoriesSection from "../../components/admin/AdminCategoriesSection.astro";
import AdminTablesSection from "../../components/admin/AdminTablesSection.astro";
import { createSupabaseSsrClient } from "../../lib/supabase-ssr.js";

const supabase = createSupabaseSsrClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

Astro.response.headers.set("Cache-Control", "private, no-store, max-age=0");
const { data: claimsResult } = await supabase.auth.getClaims();
const claims = claimsResult?.claims;
const userId = claims?.sub;
/** @type {{ id: string, email: string } | null} */
let adminUser = null;
let loginMessage = "";

if (userId) {
  const { data: adminRecord, error: adminError } = await supabase
    .from("admin_users")
    .select("user_id")
    .eq("user_id", userId)
    .maybeSingle();

  if (!adminError && adminRecord) {
    adminUser = { id: userId, email: claims.email || "" };
  } else if (!adminError) {
    await supabase.auth.signOut();
    loginMessage = "Esta cuenta no tiene permisos de administrador.";
  } else {
    console.error(
      "No se pudo validar los permisos del administrador:",
      adminError,
    );
    loginMessage = "No se pudo validar el acceso. Intenta nuevamente.";
  }
}

const isAdmin = Boolean(adminUser);
/** @type {string[]} */
const validViews = [
  "overview",
  "songs",
  "artists",
  "products",
  "categories",
  "tables",
  "settings",
];
const requestedView = Astro.url.searchParams.get("view") || "overview";
const activeView = validViews.includes(requestedView)
  ? requestedView
  : "overview";
/** @type {Record<string, string>} */
const viewLabels = {
  overview: "Resumen",
  songs: "Canciones",
  artists: "Artistas",
  products: "Carta / Productos",
  categories: "Categorías",
  tables: "Mesas y barra",
  settings: "Configuración",
};
const query = Astro.url.searchParams;
/** @param {string} name */
const positivePage = (name:any) => {
  const value = Number.parseInt(query.get(name) || "0", 10);
  return Number.isFinite(value) && value >= 0 ? value : 0;
};
const songPage = positivePage("songPage");
const artistPage = positivePage("artistPage");
const songPageSize = 30;
const artistPageSize = 30;
const songSearch = (query.get("songSearch") || "")
  .trim()
  .replace(/\s+/g, " ")
  .slice(0, 80);
const artistSearch = (query.get("artistSearch") || "")
  .trim()
  .replace(/\s+/g, " ")
  .slice(0, 80);
const productSearch = (query.get("productSearch") || "")
  .trim()
  .replace(/\s+/g, " ")
  .slice(0, 80);
const genreId = query.get("genre") || "";
const languageId = query.get("language") || "";
const productCategoryId = query.get("category") || "";
const productAvailability = query.get("availability") || "";

/** Una canción y sus relaciones tal como se muestran en la tabla del panel. */
/** @typedef {{ id: string, title: string, artist_id: string | null, genre_id: string | null, language_id: string | null, legacy_artist?: { name: string } | null, song_artists?: Array<{ position: number, artist?: { name: string } | null }>, genres?: { name: string } | null, languages?: { name: string } | null }} AdminSong */
/** @typedef {{ id: string, name: string }} AdminOption */
/** @typedef {{ id: string, name: string, image_url: string | null }} AdminArtist */
/** @typedef {{ id: string, name: string, icon: string | null, display_order: number }} AdminCategory */
/** @typedef {{ id: string, name: string, description: string | null, price: number, category_id: string | null, image_url: string | null, available: boolean, menu_categories?: { name: string, icon: string | null } | null }} AdminProduct */
/** @typedef {{ id: string, name: string, capacity: number, active: boolean }} AdminTable */

/** @type {AdminSong[]} */
let songRows = [];
let songTotal = 0;
/** @type {AdminArtist[]} */
let artistRows = [];
let artistTotal = 0;
/** @type {AdminOption[]} */
let genres = [];
/** @type {AdminOption[]} */
let languages = [];
/** @type {AdminCategory[]} */
let categories = [];
/** @type {AdminProduct[]} */
let products = [];
/** @type {AdminTable[]} */
let tables = [];
/** @type {{ business_name: string | null, address: string | null, whatsapp_number: string | null, whatsapp_bar: string | null, schedule: string | null, max_songs_per_order: number | null, logo_url: string | null, is_open: boolean }} */
let settings = {
  business_name: "",
  address: "",
  whatsapp_number: "",
  whatsapp_bar: "",
  schedule: "",
  max_songs_per_order: 2,
  logo_url: "",
  is_open: false,
};
let overviewCounts = [0, 0, 0, 0];

/** @param {any} queryBuilder @returns {Promise<any[]>} */
async function readRows(queryBuilder) {
  const { data, error } = await queryBuilder;
  if (error) {
    console.error("No se pudo cargar información del panel:", error);
    return [];
  }
  return data || [];
}

if (isAdmin) {
  const [genreRows, languageRows, categoryRows, settingsResult, counts] =
    await Promise.all([
      readRows(supabase.from("genres").select("id,name").order("name")),
      readRows(supabase.from("languages").select("id,name").order("name")),
      readRows(
        supabase
          .from("menu_categories")
          .select("id,name,icon,display_order")
          .order("display_order"),
      ),
      supabase.from("settings").select("*").eq("id", true).maybeSingle(),
      Promise.all(
        ["songs", "artists", "menu_items", "tables"].map(async (table) => {
          const queryBuilder = supabase
            .from(table)
            .select("*", { count: "exact", head: true });
          if (table === "tables") queryBuilder.eq("active", true);
          const { count, error } = await queryBuilder;
          if (error) console.error(`No se pudo contar ${table}:`, error);
          return count || 0;
        }),
      ),
    ]);
  genres = genreRows;
  languages = languageRows;
  categories = categoryRows;
  settings = { ...settings, ...(settingsResult.data || {}) };
  if (settingsResult.error)
    console.error("No se pudo cargar la configuración:", settingsResult.error);
  overviewCounts = counts;

  let songQuery = supabase
    .from("songs")
    .select(
      "id,title,artist_id,genre_id,language_id,legacy_artist:artists!songs_artist_id_fkey(name),song_artists(position,artist:artists(name)),genres(name),languages(name)",
      { count: "exact" },
    )
    .order("title");
  if (songSearch) {
    const safeTerm = songSearch.replace(/[,%()]/g, " ").trim();
    const artistMatches = await readRows(
      supabase
        .from("artists")
        .select("id")
        .ilike("name", `%${safeTerm}%`)
        .limit(5000),
    );
    /** @type {string[]} */
    let matchingSongIds = [];
    if (artistMatches.length) {
      const artistIds = artistMatches.map((artist) => artist.id);
      const links = await readRows(
        supabase
          .from("song_artists")
          .select("song_id")
          .in("artist_id", artistIds),
      );
      matchingSongIds = [...new Set(links.map((link) => link.song_id))];
    }
    if (matchingSongIds.length) {
      songQuery = songQuery.or(
        `title.ilike.%${safeTerm}%,id.in.(${matchingSongIds.join(",")})`,
      );
    } else {
      songQuery = songQuery.ilike("title", `%${safeTerm}%`);
    }
  }
  if (genreId) songQuery = songQuery.eq("genre_id", genreId);
  if (languageId) songQuery = songQuery.eq("language_id", languageId);
  const songOffset = songPage * songPageSize;
  const {
    data: songsResult,
    count: songsCount,
    error: songsError,
  } = await songQuery.range(songOffset, songOffset + songPageSize - 1);
  if (songsError)
    console.error("No se pudo cargar canciones para el panel:", songsError);
  songRows = songsResult || [];
  songTotal = songsCount || 0;

  let artistQuery = supabase
    .from("artists")
    .select("id,name,image_url", { count: "exact" })
    .order("name");
  if (artistSearch)
    artistQuery = artistQuery.ilike(
      "name",
      `%${artistSearch.replace(/[\%_,]/g, " ")}%`,
    );
  const artistOffset = artistPage * artistPageSize;
  const {
    data: artistResult,
    count: artistsCount,
    error: artistsError,
  } = await artistQuery.range(artistOffset, artistOffset + artistPageSize - 1);
  if (artistsError)
    console.error("No se pudo cargar artistas para el panel:", artistsError);
  artistRows = artistResult || [];
  artistTotal = artistsCount || 0;

  let productQuery = supabase
    .from("menu_items")
    .select(
      "id,name,description,price,category_id,image_url,available,menu_categories(name,icon)",
    )
    .order("name");
  if (productSearch)
    productQuery = productQuery.ilike(
      "name",
      `%${productSearch.replace(/[\%_,]/g, " ")}%`,
    );
  if (productCategoryId)
    productQuery = productQuery.eq("category_id", productCategoryId);
  if (productAvailability)
    productQuery = productQuery.eq("available", productAvailability === "true");
  products = await readRows(productQuery);
  tables = await readRows(supabase.from("tables").select("*").order("name"));
}
---

<AdminLayout>
  <div class="login-screen" id="login-screen" hidden={isAdmin}>
    <div class="login-card">
      <div class="login-logo">Z</div>
      <p class="eyebrow">Z-KARAOKE · ADMINISTRACIÓN</p>
      <h1>Bienvenido de nuevo</h1>
      <p class="login-subtitle">
        Ingresa con tu cuenta autorizada para administrar el local.
      </p>
      <form id="login-form">
        <label>
          Correo electrónico
          <input
            type="email"
            name="email"
            placeholder="admin@zkaraoke.com"
            autocomplete="username"
            required
          />
        </label>
        <label>
          Contraseña
          <input
            type="password"
            name="password"
            placeholder="••••••••"
            autocomplete="current-password"
            required
          />
        </label>
        <p class="form-error" id="login-error" aria-live="polite">
          {loginMessage}
        </p>
        <button
          class="btn btn-primary btn-block"
          type="submit"
          id="login-submit"
        >
          Iniciar sesión <span>→</span>
        </button>
      </form>
      <small class="login-foot">
        Acceso privado · Protegido por Supabase Auth + RLS
      </small>
    </div>
  </div>

  <div
    class="admin-app"
    id="admin-app"
    data-admin-email={adminUser?.email || ""}
    data-active-view={activeView}
    hidden={!isAdmin}
  >
    <AdminSidebar activeView={activeView} />
    <div class="main-area">
      <header class="topbar">
        <button class="mobile-menu" id="mobile-menu" aria-label="Abrir menú">
          ☰
        </button>
        <div class="breadcrumb">
          <span>Panel</span>
          <b>/</b>
          <strong id="breadcrumb-current">{viewLabels[activeView]}</strong>
        </div>
        <div class="topbar-right">
          <span class="status-pill">
            <i></i>
            <span id="business-status">
              {settings.is_open ? "Local abierto" : "Local cerrado"}
            </span>
          </span>
          <span class="top-avatar">Z</span>
        </div>
      </header>
      <main class="content">
        <section
          class:list={["view-section", activeView === "overview" && "active"]}
          id="view-overview"
        >
          <div class="page-title-row">
            <div>
              <p class="eyebrow">VISTA GENERAL</p>
              <h1>Resumen del negocio</h1>
              <p class="subheading">
                Controla el catálogo y la configuración de Z-Karaoke desde un
                solo lugar.
              </p>
            </div>
            <span class="date-chip" id="today-date"></span>
          </div>
          <div class="stats-grid">
            <StatCard
              label="Canciones registradas"
              value={overviewCounts[0].toLocaleString("es-PE")}
              detail="Catálogo musical"
              icon="♫"
              id="stat-songs"
            />
            <StatCard
              label="Artistas"
              value={overviewCounts[1].toLocaleString("es-PE")}
              detail="Biblioteca de artistas"
              icon="♬"
              tone="blue"
              id="stat-artists"
            />
            <StatCard
              label="Productos en carta"
              value={overviewCounts[2].toLocaleString("es-PE")}
              detail="Productos registrados"
              icon="▣"
              tone="orange"
              id="stat-products"
            />
            <StatCard
              label="Mesas activas"
              value={overviewCounts[3].toLocaleString("es-PE")}
              detail="Mesas y espacios habilitados"
              icon="▦"
              tone="green"
              id="stat-tables"
            />
          </div>
          <div class="dashboard-grid">
            <article class="panel-card welcome-card">
              <div>
                <p class="eyebrow">CENTRO DE CONTROL</p>
                <h2>Tu local, bajo control.</h2>
                <p>
                  Administra las canciones que tus clientes pueden pedir,
                  actualiza la carta y mantén los datos del negocio al día.
                </p>
                <button class="btn btn-primary" data-go="songs">
                  Administrar canciones <span>→</span>
                </button>
              </div>
              <div class="welcome-art">♫</div>
            </article>
            <article class="panel-card quick-panel">
              <div class="panel-heading">
                <div>
                  <h3>Accesos rápidos</h3>
                  <p>Acciones frecuentes</p>
                </div>
              </div>
              <button class="quick-link" data-action="new-song">
                <span class="quick-icon purple">♫</span>
                <span>
                  <strong>Agregar canción</strong>
                  <small>Incorpora un nuevo tema</small>
                </span>
                <b>↗</b>
              </button>
              <button class="quick-link" data-action="new-product">
                <span class="quick-icon orange">▣</span>
                <span>
                  <strong>Nuevo producto</strong>
                  <small>Actualiza tu carta</small>
                </span>
                <b>↗</b>
              </button>
              <button class="quick-link" data-go="settings">
                <span class="quick-icon green">⚙</span>
                <span>
                  <strong>Datos del negocio</strong>
                  <small>Horario y WhatsApp</small>
                </span>
                <b>↗</b>
              </button>
            </article>
          </div>
          <article class="panel-card info-panel">
            <div class="panel-heading">
              <div>
                <h3>Estado de configuración</h3>
                <p>Información recuperada de Supabase</p>
              </div>
              <button class="text-button" data-go="settings">
                Editar configuración →
              </button>
            </div>
            <div class="info-grid">
              <div>
                <small>Nombre comercial</small>
                <strong id="info-business">
                  {settings.business_name || "—"}
                </strong>
              </div>
              <div>
                <small>WhatsApp</small>
                <strong id="info-whatsapp">
                  {settings.whatsapp_number || "Sin configurar"}
                </strong>
              </div>
              <div>
                <small>Límite de canciones</small>
                <strong id="info-limit">
                  {settings.max_songs_per_order
                    ? `${settings.max_songs_per_order} canciones`
                    : "—"}
                </strong>
              </div>
              <div>
                <small>Horario</small>
                <strong id="info-schedule">
                  {settings.schedule || "Sin configurar"}
                </strong>
              </div>
            </div>
          </article>
        </section>

        <AdminSongsSection
          songs={songRows}
          genres={genres}
          languages={languages}
          total={songTotal}
          page={songPage}
          pageSize={songPageSize}
          searchTerm={songSearch}
          genreId={genreId}
          languageId={languageId}
          active={activeView === "songs"}
        />
        <ArtistManager
          artists={artistRows}
          total={artistTotal}
          page={artistPage}
          pageSize={artistPageSize}
          searchTerm={artistSearch}
          active={activeView === "artists"}
        />
        <AdminProductsSection
          products={products}
          categories={categories}
          searchTerm={productSearch}
          categoryId={productCategoryId}
          availability={productAvailability}
          active={activeView === "products"}
        />
        <AdminCategoriesSection
          categories={categories}
          active={activeView === "categories"}
        />
        <AdminTablesSection tables={tables} active={activeView === "tables"} />

        <section
          class:list={["view-section", activeView === "settings" && "active"]}
          id="view-settings"
        >
          <div class="page-title-row">
            <div>
              <p class="eyebrow">PERSONALIZACIÓN</p>
              <h1>Configuración</h1>
              <p class="subheading">
                Actualiza la información que utiliza el frontend de clientes.
              </p>
            </div>
          </div>
          <form class="settings-form panel-card" id="settings-form">
            <div class="settings-section">
              <h3>Información del negocio</h3>
              <p>Datos principales que verá el cliente.</p>
              <div class="form-grid">
                <label>
                  Nombre comercial
                  <input
                    name="business_name"
                    value={settings.business_name || ""}
                    required
                  />
                </label>
                <label>
                  Dirección
                  <input
                    name="address"
                    value={settings.address || ""}
                    placeholder="Dirección del local"
                  />
                </label>
                <label>
                  WhatsApp principal
                  <input
                    name="whatsapp_number"
                    value={settings.whatsapp_number || ""}
                    inputmode="tel"
                    placeholder="519XXXXXXXX"
                  />
                </label>
                <label>
                  WhatsApp de barra / caja
                  <input
                    name="whatsapp_bar"
                    value={settings.whatsapp_bar || ""}
                    inputmode="tel"
                    placeholder="519XXXXXXXX"
                  />
                </label>
                <label>
                  Horario de atención
                  <input
                    name="schedule"
                    value={settings.schedule || ""}
                    placeholder="Lunes a domingo desde las 6pm"
                  />
                </label>
                <label>
                  Máximo de canciones por pedido
                  <input
                    name="max_songs_per_order"
                    value={settings.max_songs_per_order || 2}
                    type="number"
                    min="1"
                    max="20"
                    required
                  />
                </label>
              </div>
            </div>
            <div class="settings-section">
              <h3>Identidad y disponibilidad</h3>
              <p>Logo y estado de atención del local.</p>
              <div class="form-grid">
                <label>
                  URL del logotipo
                  <input
                    name="logo_url"
                    value={settings.logo_url || ""}
                    type="url"
                    placeholder="https://..."
                  />
                </label>
                <label class="toggle-field">
                  Local abierto para pedidos{" "}
                  <input
                    name="is_open"
                    type="checkbox"
                    checked={Boolean(settings.is_open)}
                  />
                  <span>
                    Permite que el frontend indique que el local está
                    atendiendo.
                  </span>
                </label>
              </div>
              <div class="logo-preview" id="logo-preview"></div>
            </div>
            <div class="settings-actions">
              <span id="settings-feedback" class="inline-feedback"></span>
              <button class="btn btn-primary" type="submit">
                Guardar configuración
              </button>
            </div>
          </form>
        </section>
      </main>
    </div>
  </div>
  <AdminRecordModal
    genres={genres}
    languages={languages}
    categories={categories}
  />
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <script>
    import "../../scripts/admin.js";
  </script>
</AdminLayout>
