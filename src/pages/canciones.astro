---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import LocationPill from '../components/LocationPill.astro';
---
<BaseLayout title="Pedir música | Karaoke & Bar">
  <div class="top-row"><a class="back-link" href="/menu">← Menú</a><span class="step-label">MÚSICA · 01</span></div>
  <PageHeading eyebrow="CATÁLOGO MUSICAL" title="Elige tu canción." description="¡Tú tienes el micrófono! Puedes pedir hasta 2 canciones." />
  <LocationPill />
  <div class="music-cart-strip"><div><span class="cart-mini-icon">♫</span><span><strong>Tu selección</strong><small><b id="song-count">0/2</b> canciones</small></span></div><a href="/resumen-musica" id="song-summary-link" class="btn btn-primary btn-small">Ver resumen →</a></div>
  <div class="filter-panel">
    <label class="search-field"><span>⌕</span><input id="song-search" type="search" placeholder="Buscar canción o artista..." /></label>
    <div class="filter-row">
      <select id="genre-filter" aria-label="Filtrar por género"><option value="">Todos los géneros</option></select>
      <select id="language-filter" aria-label="Filtrar por idioma"><option value="">Todos los idiomas</option></select>
    </div>
  </div>
  <div class="section-title"><h2>Catálogo</h2><span>Recomendadas para ti</span></div>
  <div id="song-list" class="song-list"></div>
  <button type="button" id="song-load-more" class="btn btn-outline btn-block" hidden>Mostrar más canciones</button>
  <script>import '../scripts/app.js';</script>
</BaseLayout>
