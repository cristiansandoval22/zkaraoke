---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeading from "../components/PageHeading.astro";
import LocationPill from "../components/LocationPill.astro";
import BottomCartBar from "../components/BottomCartBar.astro";
import ProductCard from "../components/ProductCard.astro";
import MenuCategoryTabs from "../components/MenuCategoryTabs.astro";
import { getMenuCatalog } from "../lib/menu.js";

let categories = [];
let products = [];
let catalogError = "";

try {
  ({ categories, products } = await getMenuCatalog());
  Astro.cache.set({ maxAge: 86_400, swr: 86_400, tags: ["menu"] });
} catch (error) {
  console.error("No se pudo renderizar la carta:", error);
  catalogError = "No se pudo cargar la carta. Intenta recargar la página.";
}
---

<BaseLayout title="Carta | Karaoke & Bar">
  <div class="top-row">
    <a class="back-link" href="/menu">
      ← Menú
    </a>
    <span class="step-label">CARTA · 01</span>
  </div>
  <PageHeading
    eyebrow="CARTA & BAR"
    title="Algo rico para compartir."
    description="Agrega tus favoritos. Puedes ajustar las cantidades aquí mismo."
  />
  <LocationPill />
  <label class="search-field product-search">
    <span>⌕</span>
    <input
      id="product-search"
      type="search"
      placeholder="Buscar en la carta..."
    />
  </label>
  <MenuCategoryTabs categories={categories} />
  <div id="product-list" class="product-grid" data-catalog-ready="true">
    {products.map((product:any) => <ProductCard product={product} />)}
    <div class="empty-state product-list__empty" id="product-empty-state" hidden={products.length > 0}>
      {catalogError || "No hay productos en esta categoría."}
    </div>
  </div>
  <BottomCartBar />
  <script>
    import "../scripts/app.js";
  </script>
</BaseLayout>
