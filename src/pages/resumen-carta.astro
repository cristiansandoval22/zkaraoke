---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeading from "../components/PageHeading.astro";
---

<BaseLayout title="Resumen de pedido | Karaoke & Bar">
  <a class="back-link" href="/carta">
    ← Volver a la carta
  </a>
  <PageHeading
    eyebrow="TU ORDEN"
    title="Revisa tu pedido."
    description="Confirma los productos y dinos cómo realizarás el pago."
  />
  <div class="summary-card">
    <div class="summary-card-head">
      <strong>🛒 Detalle del pedido</strong>
      <a class="text-link" href="/carta">
        Editar
      </a>
    </div>
    <div id="food-summary-list"></div>
    <div class="grand-total">
      <span>Total</span>
      <strong id="food-grand-total">S/ 0.00</strong>
    </div>
  </div>
  <fieldset class="payment-fieldset">
    <legend>¿Cómo vas a pagar?</legend>
    <div class="payment-options">
      <label class="payment-option">
        <input type="radio" name="payment" value="Yape" checked />
        <span>💜</span>
        <strong>Yape</strong>
      </label>
      <label class="payment-option">
        <input type="radio" name="payment" value="Plin" />
        <span>💚</span>
        <strong>Plin</strong>
      </label>
      <label class="payment-option">
        <input type="radio" name="payment" value="Tarjeta" />
        <span>💳</span>
        <strong>Tarjeta</strong>
      </label>
      <label class="payment-option">
        <input type="radio" name="payment" value="Efectivo" />
        <span>💵</span>
        <strong>Efectivo</strong>
      </label>
    </div>
  </fieldset>
  <label class="field-label" for="food-note">
    Indicaciones para cocina
    <span>Opcional</span>
  </label>
  <textarea
    id="food-note"
    class="textarea"
    rows="3"
    placeholder="Ej. Con ají aparte, sin cebolla..."
  ></textarea>

  <div class="notice">
    El método de pago es informativo para que el personal pueda acercarse
    preparado. No se realizará ningún cobro desde esta página.
  </div>

  <button class="btn btn-whatsapp btn-full" id="send-food">
    Enviar pedido a caja/barra por WhatsApp
    <span>↗</span>
  </button>
  <script>
    import "../scripts/app.js";
  </script>
</BaseLayout>
