---
const { artist } = Astro.props;
let imageUrl = "";
try {
  const parsedImageUrl = new URL(artist.image_url || "");
  if (parsedImageUrl.protocol === "https:") imageUrl = parsedImageUrl.href;
} catch {
  imageUrl = "";
}
---

<article class="artist-admin__card">
  <div class="artist-admin__portrait">
    {imageUrl ? <img src={imageUrl} alt="" loading="lazy" /> : <span aria-hidden="true">♫</span>}
  </div>
  <h2 class="artist-admin__name" title={artist.name}>{artist.name}</h2>
  <div class="artist-admin__actions">
    <button type="button" class="row-action" data-edit-artist={artist.id}>Editar</button>
  </div>
</article>

<style>
  .artist-admin__card {
    min-width: 0;
    padding: 14px;
    border: 1px solid white;
    border-radius: 15px;
    background: white;
  }
  .artist-admin__portrait {
    display: grid;
    width: 64px;
    aspect-ratio: 1;
    margin-bottom: 10px;
    place-items: center;
    overflow: hidden;
    border-radius: 50%;
    background: var(--panel2);
    color: var(--purple);
    font-size: 22px;
  }
  .artist-admin__portrait img { width: 100%; height: 100%; object-fit: cover; }
  .artist-admin__name {
    overflow: hidden;
    margin: 0 0 10px;
    font-size: 14px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .artist-admin__actions { display: flex; gap: 8px; }
</style>
