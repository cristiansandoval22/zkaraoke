---
import AdminArtistCard from "./AdminArtistCard.astro";

const {
  artists = [],
  total = 0,
  page = 0,
  pageSize = 30,
  searchTerm = "",
  active = false,
} = Astro.props;
const pageCount = Math.max(1, Math.ceil(total / pageSize));
function pageHref(pageNumber) {
  const params = new URLSearchParams({
    view: "artists",
    artistPage: String(pageNumber),
  });
  if (searchTerm) params.set("artistSearch", searchTerm);
  return `/admin?${params.toString()}`;
}
---

<section class:list={["view-section", active && "active"]} id="view-artists">
  <div class="page-title-row">
    <div>
      <p class="eyebrow">BIBLIOTECA MUSICAL</p>
      <h1>Artistas</h1>
      <p class="subheading">
        Administra los nombres y las imágenes que aparecen en el catálogo.
      </p>
    </div>
    <button class="btn btn-primary" type="button" data-action="new-artist">
      ＋ Nuevo artista
    </button>
  </div>
  <form class="artist-admin__toolbar" action="/admin" method="get">
    <input type="hidden" name="view" value="artists" />
    <label class="search-box">
      ⌕{" "}
      <input
        id="artist-search-admin"
        type="search"
        name="artistSearch"
        value={searchTerm}
        placeholder="Buscar artista..."
      />
    </label>
    <button class="btn btn-ghost" type="submit">Buscar</button>
  </form>
  <div class="artist-admin__grid" id="artists-grid" aria-live="polite">
    {artists.length ? artists.map((artist) => <AdminArtistCard artist={artist} />) : <p class="table-message">No se encontraron artistas.</p>}
  </div>
  <div class="pagination">
    <span id="artists-pagination-info">{total.toLocaleString("es-PE")} artistas · Página {page + 1} de {pageCount}</span>
    <div>
      <a class="btn btn-ghost btn-small" id="artists-prev" href={pageHref(Math.max(0, page - 1))} aria-disabled={page === 0}>
        ← Anterior
      </a>
      <a class="btn btn-ghost btn-small" id="artists-next" href={pageHref(Math.min(pageCount - 1, page + 1))} aria-disabled={page + 1 >= pageCount}>
        Siguiente →
      </a>
    </div>
  </div>
</section>

<style>
  .artist-admin__toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 18px 0;
  }
  .artist-admin__toolbar .search-box {
    flex: 1 1 220px;
  }
  .artist-admin__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  @media (min-width: 700px) {
    .artist-admin__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
      color: #ffffff00;
    }
  }
  @media (min-width: 1100px) {
    .artist-admin__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
</style>
