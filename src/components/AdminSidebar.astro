---
const { activeView = "overview" } = Astro.props;
const isActive = (view) => activeView === view;
---

<aside class="sidebar" id="sidebar">
  <a class="admin-brand" href="/admin">
    <span class="brand-symbol">Z</span>
    <span>
      <strong>Z-KARAOKE</strong>
      <small>ADMIN PANEL</small>
    </span>
  </a>

  <div class="nav-caption">GENERAL</div>
  <nav class="admin-nav">
    <a class:list={["nav-item", isActive("overview") && "active"]} data-view="overview" href="/admin?view=overview">
      <span>▦</span>
      Resumen
    </a>
  </nav>
  <div class="nav-caption">GESTIÓN DEL CATÁLOGO</div>

  <nav class="admin-nav">
    <a class:list={["nav-item", isActive("songs") && "active"]} data-view="songs" href="/admin?view=songs">
      <span>♫</span> Canciones
    </a>
    <a class:list={["nav-item", isActive("artists") && "active"]} data-view="artists" href="/admin?view=artists">
      <span>♬</span> Artistas
    </a>

    <a class:list={["nav-item", isActive("products") && "active"]} data-view="products" href="/admin?view=products">
      <span>▣</span> Carta / Productos
    </a>

    <a class:list={["nav-item", isActive("categories") && "active"]} data-view="categories" href="/admin?view=categories">
      <span>▤</span> Categorías
    </a>

    <a class:list={["nav-item", isActive("tables") && "active"]} data-view="tables" href="/admin?view=tables">
      <span>▦</span> Mesas y barra
    </a>
  </nav>

  <div class="nav-caption">SISTEMA</div>

  <nav class="admin-nav">
    <a class:list={["nav-item", isActive("settings") && "active"]} data-view="settings" href="/admin?view=settings">
      <span>⚙</span>
      Configuración
    </a>
  </nav>
  <div class="sidebar-bottom">
    <div class="profile-chip">
      <span class="avatar">Z</span>
      <span>
        <strong id="admin-email">Administrador</strong>
        <small>Acceso autorizado</small>
      </span>
    </div>
    <button class="logout-btn" id="logout-btn">
      ↪ Cerrar sesión
    </button>
  </div>
</aside>
