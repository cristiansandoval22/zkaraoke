---
const { product } = Astro.props;
const categoryName = product.category?.name || "Sin categoría";
const searchableText = `${product.name} ${product.description || ""}`
  .toLocaleLowerCase("es")
  .trim();
---

<article
  class="product-card"
  data-product-id={product.id}
  data-product-category-id={product.category_id || ""}
  data-product-name={product.name}
  data-product-price={Number(product.price)}
  data-product-available={product.available ? "true" : "false"}
  data-product-search={searchableText}
>
  <!-- <div class="product-portrait">
    <img
      src={product.image || "/images/placeholder.png"}
      alt={product.name}
      width="100"
      height="100"
      loading="lazy"
    />
  </div> -->
  <div class="product-body">
    <div class="product-meta">
      <span>{categoryName}</span>
      <span class:list={["availability", product.available && "is-available"]}>
        {product.available ? "Disponible" : "No disponible"}
      </span>
    </div>
    <h3>{product.name}</h3>
    <p>{product.description || ""}</p>
    <div class="product-bottom">
      <strong>S/ {Number(product.price).toFixed(2)}</strong>
      <button
        type="button"
        class="btn btn-primary product-add-button"
        data-product-add
        disabled={!product.available}
      >
        <span data-product-add-label>
          {product.available ? "Agregar" : "Agotado"}
        </span>
        {product.available && <span aria-hidden="true">+</span>}
      </button>
      <div class="product-card__quantity" data-product-quantity hidden>
        <button
          type="button"
          data-product-minus
          aria-label={`Quitar una unidad de ${product.name}`}
        >
          −
        </button>
        <span data-product-quantity-value aria-live="polite">
          0
        </span>
        <button
          type="button"
          data-product-plus
          aria-label={`Agregar una unidad más de ${product.name}`}
          disabled={!product.available}
        >
          +
        </button>
      </div>
    </div>
  </div>
</article>

<style>
  .product-card {
    overflow: hidden;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--panel);
  }
  .product-portrait {
    display: grid;
    width: 100%;
    aspect-ratio: 16:9;
    place-items: center;
    overflow: hidden;
    background: var(--panel2);
  }

  .product-body {
    padding: 11px;
  }

  .product-meta {
    display: flex;
    justify-content: space-between;
    gap: 5px;
    color: #b8a5ff;
    font-size: 9px;
  }

  .availability {
    color: #ff9da8;
  }

  .availability.is-available {
    color: var(--green);
  }

  .product-body h3 {
    margin: 8px 0 5px;
    font-size: 13px;
  }

  .product-body p {
    min-height: 29px;
    margin: 0 0 11px;
    color: var(--muted);
    font-size: 10px;
    line-height: 1.45;
  }

  .product-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 5px;
  }

  .product-bottom > strong {
    font-size: 12px;
    white-space: nowrap;
  }

  .product-add-button {
    min-height: 34px;
    gap: 7px;
    border-radius: 9px;
    padding: 7px 10px;
    font-size: 10px;
    white-space: nowrap;
  }

  .product-add-button span + span {
    font-size: 14px;
    line-height: 1;
  }

  .product-card__quantity {
    display: flex;
    align-items: center;
    gap: 8px;
    border-radius: 9px;
    background: #2a2939;
    padding: 4px;
  }

  .product-card__quantity button {
    border: 0;
    border-radius: 6px;
    background: #4a3a70;
    color: #fff;
    width: 25px;
    height: 25px;
    font-size: 17px;
    line-height: 1;
  }

  .product-card__quantity button:disabled {
    opacity: 0.3;
  }

  .product-card__quantity span {
    min-width: 12px;
    font-size: 11px;
    text-align: center;
  }

  .product-card [hidden] {
    display: none !important;
  }

  @media (max-width: 390px) {
    .product-body {
      padding: 9px;
    }

    .product-body h3 {
      font-size: 12px;
    }

    .product-add-button {
      min-height: 31px;
      padding: 6px 8px;
      font-size: 9px;
    }

    .product-card__quantity {
      gap: 4px;
    }

    .product-card__quantity button {
      width: 22px;
      height: 23px;
    }
  }
</style>
