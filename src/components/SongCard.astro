---
const { song } = Astro.props;
const artistNames = song.artists?.length
  ? song.artists.map((artist) => artist.name).filter(Boolean).join(", ")
  : song.artist?.name || song.artist || "Artista no registrado";
---

<article class="song-card">
  <div class="song-art">♫</div>
  <div class="song-info">
    <strong>{song.title}</strong>
    <span>{artistNames}</span>
    <div class="tag-row">
      <span class="tag">{song.genre}</span>
      <span class="tag tag-muted">{song.language}</span>
    </div>
  </div>
  <button class="btn btn-small btn-outline" data-add-song={song.id}>
    Pedir
  </button>
</article>
