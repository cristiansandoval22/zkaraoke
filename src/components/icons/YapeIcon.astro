---
const { size = 40, title = "Yape" } = Astro.props;
---
<svg
    xmlns="http://www.w3.org/2000/svg"
    xmlns:xlink="http://www.w3.org/1999/xlink"
    width={size}
    height={size}
    viewBox="0 0 500 500"
    fill="none"
    aria-label={title}
>
    <rect width="500" height="500" fill="url(#pattern0_5_3)" />
    <defs>
        <pattern
            id="pattern0_5_3"
            patternContentUnits="objectBoundingBox"
            width="1"
            height="1"
        >
            <use xlink:href="#image0_5_3" transform="scale(0.002)" />
        </pattern>
        <image
            id="image0_5_3"
            width="500"
            height="500"
            preserveAspectRatio="none"
            xlink:href="data:image/png;base64,"
        />
    </defs>
</svg>
